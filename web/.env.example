# Copie para .env e ajuste. Nunca versionar o .env.
DATABASE_URL="postgresql://clinica:clinica_dev@localhost:5432/clinica?schema=public"
REDIS_URL="redis://localhost:6379"

# Chave de criptografia de campo (32 bytes em base64). Gere uma nova por ambiente.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÃ‡ÃƒO: perder esta chave torna os campos criptografados ilegÃ­veis. Guarde um backup seguro.
FIELD_ENCRYPTION_KEY=""

# Segredo para assinar o cookie de sessÃ£o (mÃ­n. 32 caracteres).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# WhatsApp Cloud API (preencher quando a conta Meta estiver pronta)
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Segredo para o agendador chamar /api/cron/lembretes (header Authorization: Bearer <valor>).
CRON_SECRET=""

# IA de recepÃ§Ã£o (opcional). Sem a chave, a IA fica inativa e tudo vai para atendimento humano.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-5-5"

# Código exigido na primeira configuração (/setup) em produção.
SETUP_TOKEN=""

# E-mail (portal do paciente). Qualquer provedor SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Clinica <nao-responda@seudominio.com.br>"
SMTP_SECURE="false"
