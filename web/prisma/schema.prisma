// Schema inicial do MVP — ver docs/ESCOPO-UNIFICADO.md (seção 8).
// Isolamento multi-tenant: toda tabela de negócio tem clinicId.
// A política RLS no PostgreSQL será adicionada em migração SQL própria.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPCAO
  PROFISSIONAL
  FINANCEIRO
}

enum Modality {
  PRESENCIAL
  ONLINE
}

enum AppointmentStatus {
  AGENDADA
  CONFIRMADA
  COMPARECEU
  FALTOU
  CANCELADA
  REMARCADA
}

enum RecordType {
  ANAMNESE
  DEMANDA
  EVOLUCAO
  ENCAMINHAMENTO
  ENCERRAMENTO
  DOCUMENTO
  ANOTACAO_PESSOAL
}

enum RecordStatus {
  RASCUNHO
  APROVADO
}

enum MessageDirection {
  ENTRADA
  SAIDA
}

enum AiState {
  ATIVA
  PAUSADA
  TRANSFERIDA
}

enum ChargeStatus {
  PENDENTE
  PAGA
  VENCIDA
  CANCELADA
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  portalSlug String? @unique // endereço do portal do paciente (/p/<slug>)
  phone     String?
  email     String?
  address   String?
  timezone  String   @default("America/Sao_Paulo")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())

  users         User[]
  professionals Professional[]
  services      Service[]
  rooms         Room[]
  patients      Patient[]
  appointments  Appointment[]
  records       ClinicalRecord[]
  waAccounts    WaAccount[]
  waTemplates   WaTemplate[]
  conversations WaConversation[]
  automations   Automation[]
  aiConfig      AiConfig?
  charges       Charge[]
  packages      Package[]
  payouts       Payout[]
  waitlist      WaitlistEntry[]
  recordTemplates RecordTemplate[]
  expenses      Expense[]
  quickReplies  QuickReply[]
  paymentAccount PaymentAccount?
  invoices      Invoice[]
  auditLogs     AuditLog[]
  importJobs    ImportJob[]
}

model User {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  email        String
  passwordHash String
  mfaSecret    String?
  role         Role
  active       Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  sessionsValidAfter DateTime? // sessões emitidas antes disso são recusadas
  mfaBackupHashes    String[]  @default([]) // hashes (sha256) de códigos de backup do MFA
  resetTokenHash     String? // hash do link de redefinição de senha
  resetTokenExpires  DateTime?
  createdAt    DateTime @default(now())

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  professional Professional?

  @@unique([clinicId, email])
}

model Professional {
  id                String  @id @default(cuid())
  clinicId          String
  userId            String  @unique
  councilType       String? // CRP, CRM...
  councilNumber     String?
  specialty         String?
  defaultMeetingUrl String?
  color             String? // cor na agenda (#rrggbb)
  sharePercent      Int     @default(0) // % de repasse sobre o recebido

  clinic       Clinic         @relation(fields: [clinicId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  availability Availability[]
  blocks       Block[]
  appointments Appointment[]
  records      ClinicalRecord[]
  payouts      Payout[]
}

model Service {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  durationMin  Int
  priceCents   Int
  modality     Modality @default(PRESENCIAL)
  cancelPolicy Json     @default("{}")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
  packages     Package[]
}

model Room {
  id       String @id @default(cuid())
  clinicId String
  name     String

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
}

model Patient {
  id        String   @id @default(cuid())
  clinicId  String
  fullName  String
  birthDate DateTime?
  cpfEnc    String? // criptografado em nível de campo
  phoneE164 String?
  email     String?
  source    String?
  tags      String[]
  sex       String? // F | M | O
  occupation String?
  address   String?
  emergencyName  String?
  emergencyPhone String?
  insurance String? // convênio / plano
  adminNotes String? // observações administrativas (nunca clínicas)
  gatewayCustomerId String? // id do cliente no gateway (cus_...)
  status    String   @default("ATIVO")
  dedupeKey String? // hash normalizado (nome + nascimento + telefone)
  createdAt DateTime @default(now())

  clinic       Clinic              @relation(fields: [clinicId], references: [id])
  guardians    Guardian[]
  contacts     AuthorizedContact[]
  preferences  ContactPreference[]
  consents     Consent[]
  appointments Appointment[]
  records      ClinicalRecord[]
  conversations WaConversation[]
  charges      Charge[]
  waitlist     WaitlistEntry[]
  packages     Package[]

  @@index([clinicId, fullName])
  @@index([clinicId, dedupeKey])
}

model Guardian {
  id              String  @id @default(cuid())
  patientId       String
  name            String
  relation        String?
  phone           String?
  isLegalGuardian Boolean @default(false)

  patient Patient @relation(fields: [patientId], references: [id])
}

model AuthorizedContact {
  id        String @id @default(cuid())
  patientId String
  name      String
  phone     String
  scope     String // ex.: "agenda", "financeiro"

  patient Patient @relation(fields: [patientId], references: [id])
}

model ContactPreference {
  id         String  @id @default(cuid())
  patientId  String
  channel    String  @default("WHATSAPP")
  discreet   Boolean @default(true)
  quietHours Json?

  patient Patient @relation(fields: [patientId], references: [id])
}

model Consent {
  id         String    @id @default(cuid())
  patientId  String
  type       String // TRATAMENTO_DADOS | WHATSAPP_OPTIN | TERMO_SERVICO
  version    String
  acceptedAt DateTime  @default(now())
  channel    String?
  revokedAt  DateTime?

  patient Patient @relation(fields: [patientId], references: [id])
}

model ImportJob {
  id        String   @id @default(cuid())
  clinicId  String
  fileKey   String
  status    String   @default("PENDENTE")
  report    Json?
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])
}

model Availability {
  id             String @id @default(cuid())
  professionalId String
  weekday        Int // 0-6
  startTime      String // HH:mm
  endTime        String

  professional Professional @relation(fields: [professionalId], references: [id])
}

model Block {
  id             String   @id @default(cuid())
  professionalId String
  startsAt       DateTime
  endsAt         DateTime
  reason         String?

  professional Professional @relation(fields: [professionalId], references: [id])
}

model Recurrence {
  id           String        @id @default(cuid())
  rrule        String
  appointments Appointment[]
}

model Appointment {
  id             String            @id @default(cuid())
  clinicId       String
  patientId      String
  professionalId String
  serviceId      String
  roomId         String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(AGENDADA)
  recurrenceId   String?
  source         String? // WHATSAPP | IA | MANUAL
  idempotencyKey String?           @unique
  meetingUrl     String?
  cancelReason   String?
  cancelledAt    DateTime?
  packageId      String?
  patientInsuranceId String? // atendimento pelo convênio
  authorizationId    String? // autorização usada
  createdAt      DateTime          @default(now())

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  professional Professional  @relation(fields: [professionalId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  room         Room?         @relation(fields: [roomId], references: [id])
  recurrence   Recurrence?   @relation(fields: [recurrenceId], references: [id])
  package      Package?      @relation(fields: [packageId], references: [id])
  patientInsurance PatientInsurance? @relation(fields: [patientInsuranceId], references: [id])
  authorization    InsuranceAuth?    @relation(fields: [authorizationId], references: [id])
  insuranceEntry   InsuranceEntry?
  records      ClinicalRecord[]
  charges      Charge[]
  runs         AutomationRun[]

  @@index([clinicId, startsAt])
  @@index([professionalId, startsAt])
  // Anti-sobreposição: EXCLUDE constraint (btree_gist) na migração 20261118000000_appointment_no_overlap.
}

model ClinicalRecord {
  id             String       @id @default(cuid())
  clinicId       String
  patientId      String
  professionalId String
  appointmentId  String?
  type           RecordType
  contentEnc     String // conteúdo criptografado
  status         RecordStatus @default(RASCUNHO)
  version        Int          @default(1)
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  professional Professional  @relation(fields: [professionalId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  versions     ClinicalRecordVersion[]
  attachments  ClinicalAttachment[]
  grants       ClinicalAccessGrant[]

  @@index([clinicId, patientId])
}

model ClinicalRecordVersion {
  id         String   @id @default(cuid())
  recordId   String
  contentEnc String
  authorId   String
  createdAt  DateTime @default(now())

  record ClinicalRecord @relation(fields: [recordId], references: [id])
}

model ClinicalAttachment {
  id      String @id @default(cuid())
  recordId String
  fileKey String
  mime    String
  size    Int
  name       String   @default("")
  data       Bytes? // conteúdo criptografado (AES-256-GCM)
  uploadedBy String   @default("")
  createdAt  DateTime @default(now())

  record ClinicalRecord @relation(fields: [recordId], references: [id])
}

model ClinicalAccessGrant {
  id        String    @id @default(cuid())
  recordId  String
  granteeId String
  purpose   String
  grantedBy String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  record ClinicalRecord @relation(fields: [recordId], references: [id])

  @@index([granteeId])
  @@index([recordId])
}

model WaAccount {
  id            String @id @default(cuid())
  clinicId      String
  phoneNumberId String
  wabaId        String
  tokenEnc      String
  status        String @default("PENDENTE")

  clinic Clinic @relation(fields: [clinicId], references: [id])
}

model WaTemplate {
  id       String @id @default(cuid())
  clinicId String
  name     String
  category String // UTILITY | MARKETING | AUTHENTICATION
  language String @default("pt_BR")
  body     String
  status   String @default("PENDENTE")

  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  automations Automation[]
  messages    WaMessage[]
}

model WaConversation {
  id              String   @id @default(cuid())
  clinicId        String
  patientId       String?
  waContact       String
  assignedTo      String?
  aiState         AiState  @default(ATIVA)
  lastMsgAt       DateTime @default(now())
  windowExpiresAt DateTime?
  unread          Int      @default(0)

  clinic   Clinic       @relation(fields: [clinicId], references: [id])
  patient  Patient?     @relation(fields: [patientId], references: [id])
  messages WaMessage[]
  aiEvents AiEvent[]
  notes    WaNote[]

  @@unique([clinicId, waContact])
  @@index([clinicId, lastMsgAt])
}

model WaMessage {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  type           String           @default("text")
  body           String?
  templateId     String?
  waMessageId    String?          @unique // idempotência dos webhooks
  status         String           @default("ENVIADA")
  error          String?
  createdAt      DateTime         @default(now())

  conversation WaConversation @relation(fields: [conversationId], references: [id])
  template     WaTemplate?    @relation(fields: [templateId], references: [id])
}

model Automation {
  id         String  @id @default(cuid())
  clinicId   String
  trigger    String // ex.: LEMBRETE_D1, LEMBRETE_H2, POS_FALTA
  offsetMin  Int
  templateId String
  active     Boolean @default(true)

  clinic   Clinic          @relation(fields: [clinicId], references: [id])
  template WaTemplate      @relation(fields: [templateId], references: [id])
  runs     AutomationRun[]
}

model AutomationRun {
  id            String    @id @default(cuid())
  automationId  String
  appointmentId String
  scheduledFor  DateTime
  status        String    @default("AGENDADA")
  invalidatedAt DateTime?

  automation  Automation  @relation(fields: [automationId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([automationId, appointmentId])
  @@index([status, scheduledFor])
}

model AiConfig {
  id              String @id @default(cuid())
  clinicId        String @unique
  approvedContent Json   @default("{}")
  rules           Json   @default("{}")
  crisisProtocol  Json   @default("{}")
  handoffHours    Json   @default("{}")

  clinic Clinic @relation(fields: [clinicId], references: [id])
}

model AiEvent {
  id                 String   @id @default(cuid())
  conversationId     String
  intent             String
  action             String
  confirmedByPatient Boolean  @default(false)
  handoffReason      String?
  createdAt          DateTime @default(now())

  conversation WaConversation @relation(fields: [conversationId], references: [id])
}

model Charge {
  id            String       @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?
  competence    String? // AAAA-MM
  amountCents   Int
  dueDate       DateTime
  status        ChargeStatus @default(PENDENTE)
  method        String?
  paidAt        DateTime?
  gatewayId     String?   @unique // id da cobrança no gateway (pay_...)
  gatewayUrl    String? // link da fatura no gateway
  pixPayload    String? // Pix copia e cola
  pixQrImage    String? // QR Code em base64 (PNG)
  pixExpiresAt  DateTime?

  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  invoices    Invoice[]
}

model Package {
  id            String @id @default(cuid())
  clinicId      String
  patientId     String
  serviceId     String
  sessionsTotal Int
  sessionsUsed  Int    @default(0)
  priceCents    Int
  planId        String? // modelo do catálogo usado na venda
  validUntil    DateTime? // sessões só são consumidas até esta data
  createdAt     DateTime @default(now())

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  appointments Appointment[]
}

model Payout {
  id             String @id @default(cuid())
  clinicId       String
  professionalId String
  period         String // AAAA-MM
  grossCents     Int
  shareCents     Int
  status         String @default("PENDENTE")
  paidAt         DateTime?
  createdAt      DateTime @default(now())

  clinic       Clinic       @relation(fields: [clinicId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@unique([clinicId, professionalId, period])
}

// Somente inserção (reforçar com permissões/trigger no banco).
model AuditLog {
  id        String   @id @default(cuid())
  clinicId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, createdAt])
}

model WaitlistEntry {
  id             String   @id @default(cuid())
  clinicId       String
  patientId      String
  professionalId String?
  serviceId      String?
  preference     String? // dias/horários preferidos, texto livre
  notes          String?
  status         String   @default("ABERTA") // ABERTA | ATENDIDA | REMOVIDA
  createdAt      DateTime @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([clinicId, status])
}

// Modelos de registro/documento (texto-base com variáveis). professionalId nulo = modelo da clínica.
model RecordTemplate {
  id             String   @id @default(cuid())
  clinicId       String
  professionalId String?
  name           String
  type           RecordType
  content        String
  createdAt      DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
}

model Expense {
  id          String    @id @default(cuid())
  clinicId    String
  description String
  category    String
  amountCents Int
  date        DateTime // competência/vencimento (dia, UTC)
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, date])
}

// Nota interna da equipe sobre uma conversa (nunca enviada ao paciente).
model WaNote {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  body           String // criptografado
  createdAt      DateTime @default(now())

  conversation WaConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

// Respostas rápidas da recepção.
model QuickReply {
  id        String   @id @default(cuid())
  clinicId  String
  title     String
  body      String
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
}

// Conta do gateway de pagamento (Asaas) e dados fiscais padrão da clínica.
model PaymentAccount {
  id           String   @id @default(cuid())
  clinicId     String   @unique
  provider     String   @default("ASAAS")
  environment  String   @default("SANDBOX") // SANDBOX | PRODUCTION
  apiKeyEnc    String // criptografada
  webhookToken String // segredo enviado pelo gateway no cabeçalho do webhook (criptografado)
  fiscal       Json     @default("{}") // serviço municipal, alíquotas, descrição padrão
  status       String   @default("ATIVA")
  createdAt    DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])
}

// Nota fiscal de serviço (NFS-e) emitida pelo gateway.
model Invoice {
  id               String   @id @default(cuid())
  clinicId         String
  chargeId         String
  patientId        String
  provider         String   @default("ASAAS")
  externalId       String?  @unique
  status           String   @default("AGENDADA") // AGENDADA | EMITIDA | CANCELANDO | CANCELADA | ERRO
  number           String?
  pdfUrl           String?
  xmlUrl           String?
  valueCents       Int
  serviceDescription String
  errorMessage     String?
  createdAt        DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])
  charge Charge @relation(fields: [chargeId], references: [id])

  @@index([clinicId, createdAt])
  @@index([chargeId])
}

// Eventos de webhook já processados (idempotência: o gateway pode reenviar).
model WebhookEvent {
  id         String   @id // id do evento no provedor
  provider   String
  receivedAt DateTime @default(now())
}

// Link de acesso ao portal do paciente (uso único, curta duração).
model PortalLink {
  id        String    @id @default(cuid())
  clinicId  String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String? // quando gerado pela equipe
  createdAt DateTime  @default(now())

  @@index([clinicId, email])
}

// ---- Módulo clínico de psicologia ----

// Aplicação de uma escala (PHQ-9, GAD-7...). As respostas e a pontuação ficam criptografadas.
model ScaleAssignment {
  id             String    @id @default(cuid())
  clinicId       String
  patientId      String
  professionalId String
  scaleKey       String // PHQ9 | GAD7
  status         String    @default("PENDENTE") // PENDENTE | RESPONDIDA | CANCELADA
  source         String    @default("PORTAL") // PORTAL | SESSAO
  dataEnc        String? // JSON criptografado: { answers, score, severity }
  riskFlag       Boolean   @default(false) // resposta de risco (ex.: item 9 do PHQ-9)
  riskAckAt      DateTime? // profissional ciente do alerta
  seenAt         DateTime? // profissional já viu o resultado
  sentAt         DateTime  @default(now())
  answeredAt     DateTime?

  @@index([clinicId, patientId])
  @@index([professionalId, status])
}

model TherapyPlan {
  id             String   @id @default(cuid())
  clinicId       String
  patientId      String
  professionalId String
  focusEnc       String // formulação/foco do plano (criptografado)
  status         String   @default("ATIVO") // ATIVO | CONCLUIDO
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  goals TherapyGoal[]

  @@index([clinicId, patientId])
}

model TherapyGoal {
  id         String    @id @default(cuid())
  planId     String
  textEnc    String // objetivo/meta (criptografado)
  status     String    @default("EM_ANDAMENTO") // EM_ANDAMENTO | ALCANCADA | PAUSADA | ABANDONADA
  progress   Int       @default(0) // 0 a 100
  targetDate DateTime?
  noteEnc    String? // último acompanhamento (criptografado)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  plan TherapyPlan @relation(fields: [planId], references: [id])

  @@index([planId])
}

// Termos e contratos da clínica. Cada versão é imutável (uma linha por versão).
model ClinicDocument {
  id        String   @id @default(cuid())
  clinicId  String
  key       String // identifica o documento (ex.: tcle, contrato)
  kind      String // TCLE | CONTRATO | OUTRO
  title     String
  body      String
  version   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  acceptances DocumentAcceptance[]

  @@unique([clinicId, key, version])
  @@index([clinicId, active])
}

model DocumentAcceptance {
  id             String   @id @default(cuid())
  clinicId       String
  patientId      String
  documentId     String
  method         String // PORTAL | PRESENCIAL
  acceptedByName String
  relation       String? // "próprio" ou parentesco do responsável
  ip             String?
  acceptedAt     DateTime @default(now())

  document ClinicDocument @relation(fields: [documentId], references: [id])

  @@unique([patientId, documentId])
  @@index([clinicId, patientId])
}

// ---- Convênios (planos de saúde) ----

model Insurer {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  cnpj         String?
  paymentDays  Int      @default(30) // prazo médio de pagamento (dias após o atendimento)
  sharePercent Int? // % de repasse do profissional neste convênio (null = usa o do profissional)
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())

  prices  InsurerPrice[]
  plans   PatientInsurance[]
  entries InsuranceEntry[]
  batches InsuranceBatch[]

  @@unique([clinicId, name])
}

// Tabela de valores: quanto o convênio paga por serviço.
model InsurerPrice {
  id         String @id @default(cuid())
  insurerId  String
  serviceId  String
  priceCents Int
  tussCode   String? // código do procedimento na tabela TUSS, quando o convênio exige

  insurer Insurer @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@unique([insurerId, serviceId])
}

// Carteirinha do paciente em um convênio.
model PatientInsurance {
  id         String    @id @default(cuid())
  clinicId   String
  patientId  String
  insurerId  String
  planName   String?
  cardEnc    String // número da carteirinha (criptografado)
  validUntil DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  insurer        Insurer         @relation(fields: [insurerId], references: [id])
  authorizations InsuranceAuth[]
  appointments   Appointment[]

  @@index([clinicId, patientId])
}

// Autorização (guia/senha) com limite de sessões.
model InsuranceAuth {
  id                 String    @id @default(cuid())
  clinicId           String
  patientInsuranceId String
  code               String
  sessionsTotal      Int
  validUntil         DateTime?
  createdAt          DateTime  @default(now())

  patientInsurance PatientInsurance @relation(fields: [patientInsuranceId], references: [id], onDelete: Cascade)
  appointments     Appointment[]

  @@index([patientInsuranceId])
}

// Valor a receber do convênio por atendimento realizado (uma linha por atendimento).
model InsuranceEntry {
  id             String    @id @default(cuid())
  clinicId       String
  insurerId      String
  patientId      String
  professionalId String
  appointmentId  String    @unique
  amountCents    Int
  serviceDate    DateTime
  competence     String // AAAA-MM do atendimento
  expectedDate   DateTime // previsão de pagamento
  status         String    @default("A_FATURAR") // A_FATURAR | FATURADO | PAGO | CANCELADO (glosa entra na fase 3)
  paidAt         DateTime?
  paymentMonth   String? // AAAA-MM do recebimento (base do repasse)
  batchId        String?
  guideNumber    String? // número da guia dentro do lote
  createdAt      DateTime  @default(now())

  insurer     Insurer     @relation(fields: [insurerId], references: [id])
  batch       InsuranceBatch? @relation(fields: [batchId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([clinicId, competence])
  @@index([clinicId, status])
  @@index([professionalId, paymentMonth])
}

// Lote de faturamento: atendimentos de uma competência enviados juntos ao convênio.
model InsuranceBatch {
  id            String    @id @default(cuid())
  clinicId      String
  insurerId     String
  competence    String // AAAA-MM
  number        Int // sequencial por clínica
  status        String    @default("ABERTO") // ABERTO | ENVIADO
  sentAt        DateTime?
  protocol      String? // protocolo de recebimento do convênio
  invoiceNumber String? // nota fiscal emitida para o convênio (por fora ou integrada na fase 3)
  invoiceDate   DateTime?
  invoiceUrl    String?
  notes         String?
  createdAt     DateTime  @default(now())

  insurer Insurer          @relation(fields: [insurerId], references: [id])
  entries InsuranceEntry[]

  @@unique([clinicId, number])
  @@index([insurerId, competence])
}

// Catálogo de pacotes definido pelo financeiro: preço e sessões fixos.
model PackagePlan {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  serviceId    String
  sessions     Int
  priceCents   Int
  validityDays Int? // validade após a venda (vazio = sem validade)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([clinicId, active])
}

// Pedido do profissional para a recepção/financeiro oferecer um pacote ao paciente.
model PackageRequest {
  id             String    @id @default(cuid())
  clinicId       String
  patientId      String
  planId         String
  professionalId String
  note           String?
  status         String    @default("PENDENTE") // PENDENTE | ATENDIDA | RECUSADA
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([clinicId, status])
}
